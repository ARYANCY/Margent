{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"],
      "@agents/*": ["../../packages/agents/src/*"],
      "@graph/*": ["../../packages/graph/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/**/*"]
}
