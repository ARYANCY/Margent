# ==========================================
# MARGENT MONOREPO ENVIRONMENT CONFIGURATION
# ==========================================

# ML Microservice Port & Host
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_URL=http://127.0.0.1:8000

# Backend API Port & Host
API_PORT=4000
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4000

# Web Visualizer Port
WEB_PORT=5173
WEB_URL=http://127.0.0.1:5173

# Large Language Model Inference Keys
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional xAI Grok Key: https://console.x.ai/
XAI_API_KEY=your_xai_grok_key_here
