{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["packages/shared/src/index.ts"],
      "@shared/*": ["packages/shared/src/*"],
      "@agents": ["packages/agents/src/index.ts"],
      "@agents/*": ["packages/agents/src/*"],
      "@graph": ["packages/graph/src/index.ts"],
      "@graph/*": ["packages/graph/src/*"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"]
}
